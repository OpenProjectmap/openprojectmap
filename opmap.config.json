{
  "$schema": "./schema/config.v1.json",
  "format": 1,
  "name": "OpenProjectMap",
  "docs": {
    "roadmap": "docs/project/ROADMAP.md",
    "decisions": "docs/project/DECISIONS.md",
    "changelog": "CHANGELOG.md"
  },
  "git": {
    "enabled": true,
    "branches": { "live": "main" },
    "areas": ["src/core", "src/node", "src/render", "src/cli", "docs", "templates", "test"]
  },
  "output": { "dir": ".opmap" },
  "staleAfterDays": 14
}
