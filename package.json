{
  "name": "openprojectmap",
  "version": "0.5.0",
  "description": "Turn three markdown files (ROADMAP, DECISIONS, CHANGELOG) into one self-contained HTML project map.",
  "license": "AGPL-3.0-only",
  "author": "OpenProjectMap contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenProjectmap/openprojectmap.git"
  },
  "homepage": "https://github.com/OpenProjectmap/openprojectmap#readme",
  "bugs": {
    "url": "https://github.com/OpenProjectmap/openprojectmap/issues"
  },
  "keywords": [
    "roadmap",
    "project-management",
    "markdown",
    "changelog",
    "decisions",
    "project-map",
    "ai-agents",
    "vibe-coding",
    "cli"
  ],
  "type": "module",
  "bin": {
    "openprojectmap": "dist/cli.js",
    "opmap": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "schema": "node scripts/gen-schema.mjs",
    "prebuild": "pnpm assets",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pretypecheck": "pnpm assets",
    "prelint": "pnpm assets",
    "pretest": "pnpm assets",
    "pretest:coverage": "pnpm assets"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
