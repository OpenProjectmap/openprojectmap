{
  "name": "openprojectmap",
  "version": "0.0.1",
  "description": "Turn three markdown files (ROADMAP, DECISIONS, CHANGELOG) into one self-contained HTML project map.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openprojectmap": "dist/cli.js",
    "opmap": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
