      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "sha",
        "date",
        "subject"
      ],
      "additionalProperties": false
    },
    "Derived": {
      "type": "object",
      "properties": {
        "currentVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall": {
          "$ref": "#/definitions/Progress"
        },
        "needsYourCall": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "type": "object",
          "properties": {
            "isStale": {
              "type": "boolean"
            },
            "days": {
              "type": [
                "number",
                "null"
              ]
            },
            "commitsSince": {
              "type": [
                "number",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "isStale",
            "days",
            "commitsSince",
            "reason"
          ],
          "additionalProperties": false
        },
        "timeline": {
          "type": "object",
          "properties": {
            "start": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ISODate"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ISODate"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "milestoneProgress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reached": {
                "type": "boolean"
              },
              "pct": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "reached",
              "pct"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "currentVersionId",
        "nextVersionId",
        "overall",
        "needsYourCall",
        "topRisks",
        "stale",
        "timeline",
        "milestoneProgress"
      ],
      "additionalProperties": false
