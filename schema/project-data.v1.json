    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "message": {
          "type": "string",
          "description": "One sentence that names the offending value."
        },
        "hint": {
          "type": "string",
          "description": "How to fix it, imperative."
        },
        "file": {
          "type": "string",
          "description": "Display path, repo-relative with `/`."
        },
        "line": {
          "type": "number",
          "description": "1-based."
        },
        "column": {
          "type": "number",
          "description": "1-based."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    }
  },
  "$id": "https://openprojectmap.dev/schema/project-data.v1.json",
  "title": "OpenProjectMap ProjectData v1"
}
